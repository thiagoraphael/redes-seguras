---
import { getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Abas from '@/components/ui/Abas.astro';
import AvisoEtico from '@/components/ui/AvisoEtico.astro';
import Atividade from '@/components/ui/Atividade.astro';
import Referencias from '@/components/ui/Referencias.astro';
import Quiz from '@/components/interativos/Quiz/Quiz';
import { modulosDa, slugDoModulo, type Modulo } from '@/lib/modulos';
import { DISCIPLINAS, formatarData } from '@/lib/texto';
import { idQuiz } from '@/lib/ids';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const modulos = await modulosDa();
  // Só módulos liberados viram página.
  return modulos
    .filter((m) => m.data.liberado)
    .map((m) => ({ params: { disciplina: m.data.disciplina, slug: slugDoModulo(m) }, props: { modulo: m } }));
}

const { modulo } = Astro.props as { modulo: Modulo };
const d = modulo.data;
const info = DISCIPLINAS[d.disciplina];
const { Content } = await render(modulo);
const quiz = d.quiz ? await getEntry(d.quiz) : undefined;

const abas = [{ id: 'teoria', rotulo: 'Teoria' }];
if (d.lab.length) abas.push({ id: 'lab', rotulo: info.aba });
if (quiz) abas.push({ id: 'revisao', rotulo: 'Revisão rápida' });
---
<Base titulo={`${d.titulo} (Encontro ${d.encontro})`} descricao={d.resumo}>
  <div class="container" data-id-modulo={modulo.id}>
    <nav aria-label="Você está em" class="trilha">
      <ol>
        <li><a href={url()}>Início</a></li>
        <li><a href={url(`${d.disciplina}/`)}>{info.curto}</a></li>
        <li><span aria-current="page">Encontro {d.encontro}</span></li>
      </ol>
    </nav>

    <header class="cab-modulo">
      <p class="cab-meta">
        <span class={`etiqueta etiqueta-${d.disciplina}`}>{info.nome}</span>
        <span>Encontro {d.encontro}{d.data && `, ${formatarData(d.data)}`}</span>
      </p>
      <h1>{d.titulo}</h1>
      <p class="cab-resumo">{d.resumo}</p>
      {
        d.objetivos.length > 0 && (
          <details class="objetivos" open>
            <summary>Ao final deste encontro você deve conseguir</summary>
            <ul>
              {d.objetivos.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </details>
        )
      }
    </header>

    <Abas abas={abas} rotuloGrupo={`Seções do encontro ${d.encontro}`}>
      <div slot="teoria">
        <article class="prosa">
          <Content />
        </article>
        <p class="proximo">
          Leu tudo? Vá para a aba{' '}
          {d.lab.length ? <a href="#lab">{info.aba}</a> : <a href="#revisao">Revisão rápida</a>}.
        </p>
        <Referencias itens={d.referencias} />
      </div>

      {
        d.lab.length > 0 && (
          <div slot="lab">
            {d.disciplina === 'ferramentas' && <AvisoEtico />}
            {d.lab.map((a) => (
              <Atividade atividade={a} idModulo={modulo.id} />
            ))}
            {quiz && (
              <p class="proximo">
                Terminou? Faça a <a href="#revisao">Revisão rápida</a>.
              </p>
            )}
          </div>
        )
      }

      {
        quiz && (
          <div slot="revisao">
            <h2 class="titulo-revisao">{quiz.data.titulo}</h2>
            <p>
              {quiz.data.questoes.length} questões, uma por vez, com explicação depois de responder. O placar fica só na
              sua tela.
            </p>
            <div class="caixa-quiz">
              <Quiz client:visible quiz={quiz.data} idQuiz={idQuiz(modulo.id)} />
            </div>
          </div>
        )
      }
    </Abas>
  </div>
</Base>

<script>
  import { marcarVisto } from '@/lib/progresso';
  const id = document.querySelector<HTMLElement>('[data-id-modulo]')?.dataset.idModulo;
  if (id) marcarVisto(id);
</script>

<style>
  .trilha {
    font-size: var(--tam-sm);
    padding: var(--esp-4) 0 0;
    color: var(--cor-texto-suave);
  }
  .trilha a {
    color: var(--cor-texto-suave);
  }
  .trilha ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .trilha li + li::before {
    content: '/';
    margin: 0 0.5em;
    color: var(--cor-borda-forte);
  }
  .cab-modulo {
    padding: var(--esp-4) 0 var(--esp-5);
    max-width: 860px;
  }
  .cab-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
    align-items: center;
    font-size: var(--tam-sm);
    color: var(--cor-texto-suave);
    font-weight: 600;
  }
  .cab-modulo h1 {
    margin-bottom: var(--esp-2);
  }
  .cab-resumo {
    font-size: var(--tam-lg);
    color: var(--cor-texto-suave);
  }
  .objetivos {
    background: var(--cor-superficie);
    border: 1px solid var(--cor-borda);
    border-radius: var(--raio-sm);
    padding: var(--esp-3) var(--esp-4);
  }
  .objetivos summary {
    font-weight: 700;
    cursor: pointer;
  }
  .objetivos ul {
    margin: var(--esp-2) 0 0;
  }
  .proximo {
    margin-top: var(--esp-6);
    font-weight: 600;
  }
  .titulo-revisao {
    margin-top: 0;
  }
  .caixa-quiz {
    max-width: 820px;
  }
</style>
