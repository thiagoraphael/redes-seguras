---
/**
 * Vitrine de todos os componentes interativos com os dados de exemplo.
 * Útil para testar um JSON novo antes de liberar o módulo.
 * O progresso aqui usa ids "demo:", separados dos módulos reais.
 */
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import AvisoEtico from '@/components/ui/AvisoEtico.astro';
import TerminalLab from '@/components/interativos/Terminal/TerminalLab';
import AnalisadorPacotes from '@/components/interativos/AnalisadorPacotes/AnalisadorPacotes';
import SimuladorMensagens from '@/components/interativos/SimuladorMensagens/SimuladorMensagens';
import ClassificadorCenarios from '@/components/interativos/ClassificadorCenarios/ClassificadorCenarios';
import IdentificadorSituacoes from '@/components/interativos/IdentificadorSituacoes/IdentificadorSituacoes';
import Quiz from '@/components/interativos/Quiz/Quiz';

const rede = (await getEntry('redes', 'lab-encontro-02'))!.data;
const captura = (await getEntry('pacotes', 'exemplo-login-http-https'))!.data;
const mensagens = (await getEntry('mensagens', 'defensiva-02-mensagens'))!.data;
const cenario = (await getEntry('cenarios', 'exemplo-clinica-risco'))!.data;
const situacoes = (await getEntry('situacoes', 'defensiva-02-situacoes'))!.data;
const quiz = (await getEntry('quizzes', 'ferramentas-02'))!.data;

const secoes = [
  ['terminal', 'TerminalLab', 'redes/lab-encontro-02.json'],
  ['pacotes', 'AnalisadorPacotes', 'pacotes/exemplo-login-http-https.json'],
  ['mensagens', 'SimuladorMensagens', 'mensagens/defensiva-02-mensagens.json'],
  ['cenarios', 'ClassificadorCenarios', 'cenarios/exemplo-clinica-risco.json'],
  ['situacoes', 'IdentificadorSituacoes', 'situacoes/defensiva-02-situacoes.json'],
  ['quiz', 'Quiz', 'quizzes/ferramentas-02.json'],
];
---
<Base titulo="Demonstração dos componentes">
  <div class="container demo">
    <h1>Demonstração dos componentes</h1>
    <p class="intro">
      Página para o professor testar os componentes com os dados de exemplo. As props de cada um estão em
      <code>docs/componentes.md</code>. O progresso feito aqui não se mistura com o dos módulos.
    </p>
    <nav aria-label="Componentes nesta página">
      <ul class="indice">
        {secoes.map(([id, nome]) => <li><a href={`#${id}`}>{nome}</a></li>)}
      </ul>
    </nav>

    <section id="terminal">
      <h2>TerminalLab</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[0]![2]}</code></p>
      <AvisoEtico />
      <TerminalLab client:visible rede={rede} idAtividade="demo:terminal" />
    </section>

    <section id="pacotes">
      <h2>AnalisadorPacotes</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[1]![2]}</code> (exemplo para o encontro 3)</p>
      <AnalisadorPacotes client:visible captura={captura} idAtividade="demo:pacotes" />
    </section>

    <section id="mensagens">
      <h2>SimuladorMensagens</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[2]![2]}</code></p>
      <SimuladorMensagens client:visible conjunto={mensagens} idAtividade="demo:mensagens" />
    </section>

    <section id="cenarios">
      <h2>ClassificadorCenarios</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[3]![2]}</code></p>
      <ClassificadorCenarios client:visible cenario={cenario} idAtividade="demo:cenarios" />
    </section>

    <section id="situacoes">
      <h2>IdentificadorSituacoes</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[4]![2]}</code></p>
      <IdentificadorSituacoes client:visible conjunto={situacoes} idAtividade="demo:situacoes" />
    </section>

    <section id="quiz">
      <h2>Quiz</h2>
      <p class="fonte">Dados: <code>src/content/dados/{secoes[5]![2]}</code></p>
      <div style="max-width: 820px"><Quiz client:visible quiz={quiz} idQuiz="demo:quiz" /></div>
    </section>
  </div>
</Base>

<style>
  .demo {
    padding-top: var(--esp-6);
  }
  .intro {
    max-width: var(--largura-texto);
    color: var(--cor-texto-suave);
  }
  .indice {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-4);
    padding: 0;
    list-style: none;
  }
  section {
    margin-top: var(--esp-7);
    padding-top: var(--esp-4);
    border-top: 1px solid var(--cor-borda);
  }
  .fonte {
    font-size: var(--tam-sm);
    color: var(--cor-texto-suave);
  }
</style>
