  "missoes": [
    {
      "id": "metodo",
      "enunciado": "Qual método HTTP foi usado para enviar o formulário de login?",
      "dica": "Filtre por http e olhe a coluna Info.",
      "comandosSugeridos": ["http.request"],
      "resposta": { "tipo": "exata", "valor": "POST" },
      "explicacao": "Formulários de login usam POST: os dados vão no corpo da requisição, não na URL. Mas isso não esconde nada: em HTTP o corpo também viaja em texto aberto."
    },
    {
      "id": "senha-http",
      "enunciado": "Qual senha a recepção digitou no login por HTTP?",
      "dica": "Selecione o pacote do POST e veja os dados da aplicação, ou use Seguir fluxo TCP. O %40 é como o @ aparece codificado num formulário.",
      "comandosSugeridos": ["http.request.method == \"POST\""],
      "resposta": { "tipo": "umDe", "valores": ["Gato@2026", "Gato%402026"] },
      "explicacao": "Em HTTP, qualquer um que capture o tráfego lê a senha. Por isso login sem HTTPS é inaceitável, mesmo em rede interna."
    },
    {
      "id": "https",
      "enunciado": "No segundo login, por HTTPS (porta 443), dá para ler a senha na captura? Responda sim ou não.",
      "dica": "Filtre por tls e siga o fluxo TCP da porta 443.",
      "comandosSugeridos": ["tls", "tcp.port == 443"],
      "resposta": { "tipo": "umDe", "valores": ["nao", "não"] },
      "explicacao": "Com TLS, a captura mostra quem falou com quem, quando e quanto, e até o nome do site (SNI). Mas o conteúdo, incluindo a senha, está cifrado."
    }
